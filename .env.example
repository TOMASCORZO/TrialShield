# TrialShield Environment Variables
# Copy this to .env.local and fill in your values

# ─── Supabase (FREE tier) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── External APIs (ALL FREE — no paid keys needed) ──────────

# AbuseIPDB API (https://www.abuseipdb.com/account/api)
# FREE — 1,000 checks/day, no credit card
ABUSEIPDB_API_KEY=your_abuseipdb_api_key

# IP Geolocation (https://ip-api.com)
# FREE — 45 requests/minute (no API key needed for free tier)
# Optional PRO key for higher limits:
IP_API_KEY=

# ─── No API key needed (auto-configured) ─────────────────────
# XposedOrNot (breach check) — FREE, no API key, 1 req/sec
# ipapi.is (VPN/proxy detection) — FREE, no API key, 1,000/day
# TOR Project (exit nodes) — FREE, no API key
# RDAP (domain age) — FREE, no API key
# phone-lookup-api (carrier) — FREE, no API key, 5,000/month
# libphonenumber-js (phone validation) — offline, unlimited

# ─── Internal Keys ───────────────────────────────────────────

# Internal API master key for dashboard auth
TRIALSHIELD_MASTER_KEY=your_master_key_here

# Test API key for dashboard test page
NEXT_PUBLIC_TRIALSHIELD_TEST_KEY=ts_test_key_for_dashboard

# ─── Rate Limiting ───────────────────────────────────────────

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
